# Copy to `.env` (docker compose reads it automatically) and fill in a strong
# password. This drives the docker-compose.yml stack; it is separate from the
# `.env.local` used for `npm run dev` against your own database.

POSTGRES_USER=hamster
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=hamstercheek

# Host port the app is published on. Keep it behind a reverse proxy (Caddy,
# nginx, Traefik) that terminates TLS.
APP_PORT=3000
